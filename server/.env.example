PORT=8787
DATABASE_URL=postgres://user:password@host:5432/dbname
# Optional media providers used by generation layer `asset.strategy`.
# PEXELS_API_KEY também liga o banco de imagens do painel "Imagens" do editor
# (GET /api/v1/stock/photos). Sem ela a busca responde 501 e o painel avisa.
PEXELS_API_KEY=
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
# pdf-import-service (Docker separado) usado por POST /api/v1/imports/pdf — sem isto, a rota
# responde 501. O secret precisa bater com IMPORT_SECRET do outro serviço.
PDF_IMPORT_SERVICE_URL=http://127.0.0.1:8791
PDF_IMPORT_SERVICE_SECRET=
GOOGLE_FONTS_API_KEY=
